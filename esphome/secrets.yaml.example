# Copy to secrets.yaml (git-ignored) and fill in.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
# 32-byte base64 key, e.g. from: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "REPLACE_WITH_BASE64_KEY"
ota_password: "choose-an-ota-password"
# only if you enable the fallback hotspot in solax-dongle.yaml
fallback_ap_password: "choose-a-fallback-password"
