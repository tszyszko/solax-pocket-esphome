/* Copy to secrets.h only if you build by hand; flasher/build.sh generates
 * secrets.h from the SSID / PSK / REPORT_URL environment variables.
 * secrets.h is git-ignored: never commit it. */
#define WSSID "your-wifi-ssid"
#define WPASS "your-wifi-password"
/* where tools/ota_server.py listens; http only, no trailing slash */
#define REPORT "http://192.0.2.10:8080"
